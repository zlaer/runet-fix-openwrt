{
	"luci-app-runet-fix": {
		"description": "Grant access to runet-fix configuration and management",
		"read": {
			"uci": [ "runet-fix" ],
			"file": {
				"/usr/share/runet-fix/lists/*": [ "read" ],
				"/usr/share/runet-fix/lists/adblock-whitelist.txt": [ "read" ],
				"/usr/share/runet-fix/lists/adblock-blacklist.txt": [ "read" ],
				"/usr/share/runet-fix/lists/zapret-hosts.txt": [ "read" ],
				"/tmp/runet-fix-adblock.count": [ "read" ],
				"/tmp/dnsmasq.d/runet-fix-adblock.conf": [ "read", "stat" ],
				"/usr/bin/runet-fix": [ "exec" ],
				"/usr/share/runet-fix/scripts/*": [ "exec" ],
				"/sbin/logread": [ "exec" ]
			},
			"ubus": {
				"service": [ "list" ],
				"file": [ "exec", "read", "stat" ]
			}
		},
		"write": {
			"uci": [ "runet-fix" ],
			"file": {
				"/usr/share/runet-fix/lists/*": [ "write" ],
				"/usr/share/runet-fix/lists/adblock-whitelist.txt": [ "write" ],
				"/usr/share/runet-fix/lists/adblock-blacklist.txt": [ "write" ],
				"/usr/share/runet-fix/lists/zapret-hosts.txt": [ "write" ],
				"/usr/bin/runet-fix": [ "exec" ]
			},
			"ubus": {
				"service": [ "set", "event" ],
				"file": [ "exec" ]
			}
		}
	}
}
