#!/bin/sh
# /usr/bin/runet-fix - Unified CLI management tool for runet-fix
# Part of the runet-fix all-in-one suite.

VERSION_FILE="/usr/share/runet-fix/version"
CURRENT_VERSION="1.4.2"
[ -f "$VERSION_FILE" ] && CURRENT_VERSION=$(cat "$VERSION_FILE" | tr -d '\r\n ')

REPO_USER="zlaer"
REPO_NAME="runet-fix-openwrt"
REPO_BRANCH="master"
GITHUB_RAW="https://raw.githubusercontent.com/$REPO_USER/$REPO_NAME/$REPO_BRANCH"
GITHUB_API="https://api.github.com/repos/$REPO_USER/$REPO_NAME/releases/latest"

safe_download() {
    local url="$1"
    local output="$2"
    local timeout="${3:-30}"
    if curl -s -f -L -m "$timeout" "$url" -o "$output" 2>/dev/null; then
        return 0
    fi
    curl -s -f -k -L -m "$timeout" "$url" -o "$output"
}

if [ -x /usr/bin/runet-fix-core ]; then
    case "$1" in
        daemon|proxy|adblock|update-adblock|autotune|test|zapret-args|status)
            exec /usr/bin/runet-fix-core "$@"
            ;;
    esac
fi

case "$1" in
    start)
        /etc/init.d/runet-fix start
        ;;
    stop)
        /etc/init.d/runet-fix stop
        ;;
    restart)
        /etc/init.d/runet-fix restart
        ;;
    status)
        /etc/init.d/runet-fix status_all
        ;;
    version)
        if [ "$2" = "--json" ]; then
            echo "{\"version\": \"$CURRENT_VERSION\"}"
        else
            echo "$CURRENT_VERSION"
        fi
        ;;
    check-update|check_update)
        raw_res=$(curl -s -k -m 5 "$GITHUB_RAW/version" 2>/dev/null | tr -d '\r\n ')
        if echo "$raw_res" | grep -Eq '^[vV]?[0-9]+(\.[0-9]+)+$'; then
            latest="$raw_res"
        else
            api_res=$(curl -s -k -m 5 "$GITHUB_API" 2>/dev/null | grep '"tag_name":' | head -n 1 | sed -E 's/.*"([^"]+)".*/\1/' | tr -d 'v\r\n ')
            if echo "$api_res" | grep -Eq '^[vV]?[0-9]+(\.[0-9]+)+$'; then
                latest="$api_res"
            else
                latest=""
            fi
        fi

        if [ -z "$latest" ]; then
            if [ "$2" = "--json" ]; then
                echo "{\"status\": \"error\", \"current_version\": \"$CURRENT_VERSION\", \"message\": \"Repository is private or unreachable (HTTP 404/Offline)\"}"
            else
                echo "Error: Could not check for updates (Repository is private or GitHub is unreachable)."
            fi
            exit 1
        fi

        clean_curr=$(echo "$CURRENT_VERSION" | sed 's/^v//')
        clean_lat=$(echo "$latest" | sed 's/^v//')
        update_avail=0
        if [ "$clean_curr" != "$clean_lat" ]; then
            update_avail=1
        fi

        out_json=$(cat <<EOF
{
  "status": "ok",
  "current_version": "$CURRENT_VERSION",
  "latest_version": "$latest",
  "update_available": $update_avail,
  "repo_url": "https://github.com/$REPO_USER/$REPO_NAME"
}
EOF
)
        echo "$out_json" > /tmp/runet-fix-update.json 2>/dev/null
        if [ "$2" = "--json" ]; then
            echo "$out_json"
        else
            if [ "$update_avail" = "1" ]; then
                echo "Update available: $latest (current: $CURRENT_VERSION)"
                echo "Run 'runet-fix update' to install the latest version."
            else
                echo "Runet-Fix is up to date (version $CURRENT_VERSION)."
            fi
        fi
        ;;
    update)
        echo "=== [runet-fix] Starting Update from GitHub... ==="
        echo "Repository: https://github.com/$REPO_USER/$REPO_NAME (branch: $REPO_BRANCH)"

        TMP_DIR="/tmp/runet-fix-update"
        rm -rf "$TMP_DIR"
        mkdir -p "$TMP_DIR"

        TARBALL_URL="https://github.com/$REPO_USER/$REPO_NAME/archive/refs/heads/$REPO_BRANCH.tar.gz"
        echo "Downloading update archive..."
        if ! safe_download "$TARBALL_URL" "$TMP_DIR/update.tar.gz" 60; then
            echo "Error: Failed to download update archive from GitHub!"
            rm -rf "$TMP_DIR"
            exit 1
        fi

        echo "Extracting update archive..."
        if ! tar -xzf "$TMP_DIR/update.tar.gz" -C "$TMP_DIR/"; then
            echo "Error: Failed to unpack update archive!"
            rm -rf "$TMP_DIR"
            exit 1
        fi

        SRC_DIR=$(find "$TMP_DIR" -maxdepth 1 -type d -name "$REPO_NAME-*" | head -n 1)
        if [ -z "$SRC_DIR" ] || [ ! -d "$SRC_DIR/files" ]; then
            echo "Error: Invalid update package structure!"
            rm -rf "$TMP_DIR"
            exit 1
        fi

        echo "Backing up user configuration and custom lists..."
        [ -f /etc/config/runet-fix ] && cp /etc/config/runet-fix "$TMP_DIR/runet-fix.config.bak"
        [ -d /usr/share/runet-fix/lists ] && cp -r /usr/share/runet-fix/lists "$TMP_DIR/lists.bak"

        echo "Installing updated files..."
        cp -r "$SRC_DIR/files/usr/bin/"* /usr/bin/ 2>/dev/null || true
        cp -r "$SRC_DIR/files/usr/share/runet-fix/"* /usr/share/runet-fix/ 2>/dev/null || true
        cp -r "$SRC_DIR/files/usr/share/luci/menu.d/"* /usr/share/luci/menu.d/ 2>/dev/null || true
        cp -r "$SRC_DIR/files/usr/share/rpcd/acl.d/"* /usr/share/rpcd/acl.d/ 2>/dev/null || true
        cp -r "$SRC_DIR/files/www/luci-static/resources/view/runet-fix/"* /www/luci-static/resources/view/runet-fix/ 2>/dev/null || true
        cp -r "$SRC_DIR/files/etc/init.d/runet-fix" /etc/init.d/
        [ -f "$SRC_DIR/version" ] && cp "$SRC_DIR/version" /usr/share/runet-fix/version

        # Update native Rust core binary if applicable with SHA256 integrity check
        ARCH=""
        [ -f /etc/openwrt_release ] && . /etc/openwrt_release && ARCH="$DISTRIB_ARCH"
        [ -z "$ARCH" ] && ARCH=$(uname -m 2>/dev/null || echo "unknown")
        TG_ARCH=""
        case "$ARCH" in
            aarch64*|arm64) TG_ARCH="aarch64" ;;
            arm_cortex*|armhf|armv7*) TG_ARCH="armv7" ;;
            x86_64|amd64) TG_ARCH="x86_64" ;;
        esac
        if [ -n "$TG_ARCH" ] && [ -f "$SRC_DIR/prebuilt/runet-fix-$TG_ARCH" ]; then
            can_copy=1
            if [ -f "$SRC_DIR/prebuilt/SHA256SUMS" ] && command -v sha256sum >/dev/null 2>&1; then
                exp_hash=$(grep "runet-fix-$TG_ARCH" "$SRC_DIR/prebuilt/SHA256SUMS" 2>/dev/null | awk '{print $1}')
                act_hash=$(sha256sum "$SRC_DIR/prebuilt/runet-fix-$TG_ARCH" | awk '{print $1}')
                if [ -n "$exp_hash" ] && [ "$exp_hash" != "$act_hash" ]; then
                    echo "Security Warning: Checksum mismatch for binary runet-fix-$TG_ARCH! Skipping binary update."
                    can_copy=0
                fi
            fi
            if [ "$can_copy" = "1" ]; then
                echo "Updating native binary runet-fix-$TG_ARCH..."
                cp "$SRC_DIR/prebuilt/runet-fix-$TG_ARCH" /usr/bin/runet-fix-core
                chmod +x /usr/bin/runet-fix-core
                ln -sf /usr/bin/runet-fix-core /usr/bin/tg-ws-proxy
            fi
        fi

        # Restore custom lists preserving user additions
        if [ -d "$TMP_DIR/lists.bak" ]; then
            for f in "$TMP_DIR/lists.bak"/*; do
                [ -f "$f" ] && cp "$f" /usr/share/runet-fix/lists/
            done
        fi

        echo "Setting file permissions..."
        chmod +x /etc/init.d/runet-fix /usr/bin/runet-fix
        chmod +x /usr/share/runet-fix/scripts/*.sh 2>/dev/null || true
        chmod +x /usr/share/runet-fix/tg_ws_proxy/main.py 2>/dev/null || true

        echo "Clearing LuCI view and index cache..."
        rm -f /tmp/luci-indexcache*
        touch /lib/apk/db/installed /usr/lib/opkg/status 2>/dev/null || true
        killall -HUP rpcd 2>/dev/null || true
        /etc/init.d/uhttpd restart 2>/dev/null || true

        echo "Restarting runet-fix services..."
        /etc/init.d/runet-fix restart

        NEW_VER=$(cat /usr/share/runet-fix/version 2>/dev/null || echo "latest")
        echo "=========================================================="
        echo "Runet-Fix successfully updated to version $NEW_VER!"
        echo "=========================================================="
        rm -rf "$TMP_DIR"
        exit 0
        ;;
    adblock|update-adblock)
        /usr/share/runet-fix/scripts/update-adblock.sh
        ;;
    firewall)
        /usr/share/runet-fix/scripts/runet-fix-firewall.sh status
        ;;
    autotune)
        echo "Error: autotune requires the native runet-fix-core binary (not installed)." >&2
        exit 1
        ;;

    uninstall)
        if [ -x /usr/share/runet-fix/scripts/uninstall.sh ]; then
            exec /usr/share/runet-fix/scripts/uninstall.sh
        else
            echo "Error: /usr/share/runet-fix/scripts/uninstall.sh not found!"
            exit 1
        fi
        ;;
    test)
        if [ "$2" = "--json" ]; then
            yt_raw=$(curl -s -k -m 2.5 -w "%{http_code}:%{time_total}" -o /dev/null "https://www.youtube.com" 2>/dev/null || echo "000:2.5")
            yt_code=$(echo "$yt_raw" | cut -d: -f1)
            yt_time=$(echo "$yt_raw" | cut -d: -f2)
            yt_ms=$(awk "BEGIN { print int($yt_time * 1000) }")
            yt_ok=0; [ "$yt_code" != "000" ] && [ -n "$yt_code" ] && yt_ok=1

            dc_raw=$(curl -s -k -m 2.5 -w "%{http_code}:%{time_total}" -o /dev/null "https://gateway.discord.gg" 2>/dev/null || echo "000:2.5")
            dc_code=$(echo "$dc_raw" | cut -d: -f1)
            dc_time=$(echo "$dc_raw" | cut -d: -f2)
            dc_ms=$(awk "BEGIN { print int($dc_time * 1000) }")
            dc_ok=0; [ "$dc_code" != "000" ] && [ -n "$dc_code" ] && dc_ok=1

            tg_daemon=0
            if netstat -tlpn 2>/dev/null | grep -q ":1443 "; then
                tg_daemon=1
            fi

            tg_stats="{}"
            [ -f /tmp/tg-ws-proxy-stats.json ] && tg_stats=$(cat /tmp/tg-ws-proxy-stats.json 2>/dev/null || echo "{}")

            dns_ok=0; if nslookup google.com 127.0.0.1 >/dev/null 2>&1; then dns_ok=1; fi
            ad_ok=0; if nslookup ad.ae.doubleclick.net 127.0.0.1 2>/dev/null | grep -q 'NXDOMAIN\|0.0.0.0'; then ad_ok=1; fi

            test_json=$(cat <<EOF
{
  "youtube": {"ok": $yt_ok, "code": "$yt_code", "ms": $yt_ms},
  "discord": {"ok": $dc_ok, "code": "$dc_code", "ms": $dc_ms},
  "telegram": {"ok": $tg_daemon, "stats": $tg_stats},
  "dns": {"ok": $dns_ok, "adblock_ok": $ad_ok}
}
EOF
)
            echo "$test_json"
            echo "$test_json" > /tmp/runet-fix-test.json 2>/dev/null
            exit 0
        fi

        echo "=== [runet-fix Connectivity Diagnostics] ==="
        echo -n "Checking DNS resolution (google.com)... "
        if nslookup google.com 127.0.0.1 >/dev/null 2>&1; then echo "OK"; else echo "FAIL"; fi

        echo -n "Checking Adblock NXDOMAIN (ad.ae.doubleclick.net)... "
        if nslookup ad.ae.doubleclick.net 127.0.0.1 2>/dev/null | grep -q 'NXDOMAIN\|0.0.0.0'; then echo "OK (Blocked)"; else echo "FAIL (Allowed)"; fi

        echo -n "Testing YouTube HTTPS connection (port 443)... "
        yt_test=$(curl -s -k -m 3 -w "%{http_code}:%{time_total}s" -o /dev/null "https://www.youtube.com" 2>/dev/null || echo "FAIL")
        echo "$yt_test"

        echo -n "Testing Discord Gateway (gateway.discord.gg:443)... "
        dc_test=$(curl -s -k -m 3 -w "%{http_code}:%{time_total}s" -o /dev/null "https://gateway.discord.gg" 2>/dev/null || echo "FAIL")
        echo "$dc_test"

        echo -n "Testing Telegram local transparent proxy daemon (127.0.0.1:1443)... "
        if netstat -tlpn 2>/dev/null | grep -q ":1443 "; then echo "OK (Listening)"; else echo "FAIL (Stopped)"; fi
        echo "============================================="
        ;;
    log|logs)
        logread -e "runet-fix" -e "tg-ws-proxy" -e "nfqws" | tail -n 50
        ;;
    *)
        echo "runet-fix CLI v$CURRENT_VERSION - All-in-One DPI Bypass, Telegram Fix & Adblock"
        echo "Usage: runet-fix {start|stop|restart|status|version|check-update|update|update-adblock|firewall|test|autotune|log|uninstall}"
        echo "       runet-fix autotune [--json] [--apply]"
        echo "       runet-fix version [--json]"
        echo "       runet-fix check-update [--json]"
        echo "       runet-fix update"
        echo "       runet-fix test [--json]"
        exit 1
        ;;
esac
