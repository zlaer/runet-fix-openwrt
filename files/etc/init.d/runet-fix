#!/bin/sh /etc/rc.common
# /etc/init.d/runet-fix - Unified procd service for Zapret, Telegram WS, and Adblock
# Part of the runet-fix all-in-one suite.

USE_PROCD=1
START=90
STOP=10

FIREWALL_SCRIPT="/usr/share/runet-fix/scripts/runet-fix-firewall.sh"
ADBLOCK_SCRIPT="/usr/share/runet-fix/scripts/update-adblock.sh"
TG_RUST_BIN="/usr/bin/tg-ws-proxy"
TG_PY_SCRIPT="/usr/share/runet-fix/tg_ws_proxy/main.py"
TG_C_BIN="/usr/bin/tg-transproxy"

check_binary() {
    [ -x "$1" ] && "$1" --help >/dev/null 2>&1
}

find_nfqws() {
    for b in /usr/bin/nfqws2 /opt/zapret2/nfq2/nfqws2 /usr/bin/nfqws /opt/zapret/nfq/nfqws; do
        if [ -x "$b" ]; then
            echo "$b"
            return 0
        fi
    done
    return 1
}

get_zapret_args() {
    local preset="$1"
    local custom="$2"
    local bin_dir="/usr/share/runet-fix/bin"

    case "$preset" in
        youtube_4k)
            echo "--dpi-desync=fake,multisplit --dpi-desync-split-pos=1 --dpi-desync-fooling=badseq,md5sig --dpi-desync-repeats=6"
            ;;
        fakedsplit_badseq)
            echo "--dpi-desync=fakedsplit --dpi-desync-split-pos=1 --dpi-desync-fooling=badseq,md5sig --dpi-desync-repeats=6"
            ;;
        multisplit_badsum)
            echo "--dpi-desync=fake,multisplit --dpi-desync-split-pos=1 --dpi-desync-fooling=badsum --dpi-desync-repeats=4"
            ;;
        disorder2_badseq)
            echo "--dpi-desync=disorder2 --dpi-desync-split-pos=1 --dpi-desync-fooling=badseq"
            ;;
        split2_pos2)
            echo "--dpi-desync=fake,split2 --dpi-desync-split-pos=2 --dpi-desync-fooling=badseq --dpi-desync-repeats=4"
            ;;
        wsize_badsum)
            echo "--dpi-desync=fake,split2 --dpi-desync-split-pos=1 --dpi-desync-fooling=badsum --dpi-desync-wsize=4"
            ;;
        tls_cutoff)
            echo "--dpi-desync=fake --dpi-desync-repeats=6 --dpi-desync-fooling=badseq,md5sig --dpi-desync-cutoff=d4"
            ;;
        discord_fix)
            echo "--dpi-desync=fake --dpi-desync-repeats=6 --dpi-desync-any-protocol=1 --dpi-desync-cutoff=n3"
            ;;
        general_alt)
            echo "--dpi-desync=fake,fakedsplit --dpi-desync-repeats=6 --dpi-desync-fooling=ts --dpi-desync-fakedsplit-pattern=0x00 --dpi-desync-fake-tls=$bin_dir/stun.bin --dpi-desync-fake-tls=$bin_dir/tls_clienthello_www_google_com.bin --dpi-desync-fake-http=$bin_dir/tls_clienthello_www_sferum_ru.bin"
            ;;
        general_alt2)
            echo "--dpi-desync=multisplit --dpi-desync-split-seqovl=652 --dpi-desync-split-pos=2 --dpi-desync-split-seqovl-pattern=$bin_dir/tls_clienthello_www_google_com.bin"
            ;;
        general_alt3)
            echo "--dpi-desync=fake,hostfakesplit --dpi-desync-fake-tls-mod=rnd,dupsid,sni=ya.ru --dpi-desync-hostfakesplit-mod=host=ya.ru,altorder=1 --dpi-desync-fooling=ts --dpi-desync-fake-http=$bin_dir/tls_clienthello_www_sferum_ru.bin"
            ;;
        general_alt4)
            echo "--dpi-desync=fake,multisplit --dpi-desync-repeats=6 --dpi-desync-fooling=badseq --dpi-desync-badseq-increment=1000 --dpi-desync-fake-tls=$bin_dir/stun.bin --dpi-desync-fake-tls=$bin_dir/tls_clienthello_www_google_com.bin --dpi-desync-fake-http=$bin_dir/tls_clienthello_www_sferum_ru.bin"
            ;;
        general_alt5)
            echo "--dpi-desync=syndata,multidisorder"
            ;;
        general_alt6)
            echo "--dpi-desync=multisplit --dpi-desync-split-seqovl=681 --dpi-desync-split-pos=1 --dpi-desync-split-seqovl-pattern=$bin_dir/tls_clienthello_www_google_com.bin"
            ;;
        general_alt7)
            echo "--dpi-desync=multisplit --dpi-desync-split-pos=2,sniext+1 --dpi-desync-split-seqovl=679 --dpi-desync-split-seqovl-pattern=$bin_dir/tls_clienthello_www_google_com.bin"
            ;;
        general_alt8)
            echo "--dpi-desync=fake --dpi-desync-fake-tls-mod=none --dpi-desync-repeats=6 --dpi-desync-fooling=badseq --dpi-desync-badseq-increment=2 --dpi-desync-fake-http=$bin_dir/tls_clienthello_www_sferum_ru.bin"
            ;;
        general_alt9)
            echo "--dpi-desync=hostfakesplit --dpi-desync-repeats=4 --dpi-desync-fooling=ts,md5sig --dpi-desync-hostfakesplit-mod=host=ozon.ru"
            ;;
        general_alt10)
            echo "--dpi-desync=fake --dpi-desync-repeats=6 --dpi-desync-fooling=ts --dpi-desync-fake-tls=$bin_dir/stun.bin --dpi-desync-fake-tls=$bin_dir/tls_clienthello_4pda_to.bin --dpi-desync-fake-http=$bin_dir/tls_clienthello_www_sferum_ru.bin"
            ;;
        general_alt11)
            echo "--dpi-desync=fake,multisplit --dpi-desync-split-seqovl=664 --dpi-desync-split-pos=1 --dpi-desync-fooling=ts --dpi-desync-repeats=8 --dpi-desync-split-seqovl-pattern=$bin_dir/tls_clienthello_www_sferum_ru.bin --dpi-desync-fake-tls=$bin_dir/stun2.bin --dpi-desync-fake-tls=$bin_dir/tls_clienthello_www_sferum_ru.bin --dpi-desync-fake-http=$bin_dir/tls_clienthello_www_sferum_ru.bin"
            ;;
        general_alt12)
            echo "--dpi-desync=fake,multisplit --dpi-desync-split-seqovl=664 --dpi-desync-split-pos=1 --dpi-desync-fooling=ts --dpi-desync-repeats=8 --dpi-desync-split-seqovl-pattern=$bin_dir/tls_clienthello_www_sferum_ru.bin --dpi-desync-fake-tls=$bin_dir/stun.bin --dpi-desync-fake-tls=$bin_dir/tls_clienthello_www_sferum_ru.bin --dpi-desync-fake-http=$bin_dir/tls_clienthello_www_sferum_ru.bin"
            ;;
        general_alt13)
            echo "--dpi-desync=fake,hostfakesplit --dpi-desync-fooling=ts --dpi-desync-hostfakesplit-mod=host=mail.ru,altorder=1 --dpi-desync-repeats=5 --dpi-desync-fake-tls=$bin_dir/tls_clienthello_sochi_park.bin --dpi-desync-fake-tls=$bin_dir/stun2.bin --dpi-desync-fake-http=$bin_dir/tls_clienthello_sochi_park.bin"
            ;;
        general_fake_tls_auto)
            echo "--dpi-desync=fake,multidisorder --dpi-desync-split-pos=1,midsld --dpi-desync-repeats=11 --dpi-desync-fooling=badseq --dpi-desync-fake-tls=0x00000000"
            ;;
        general_fake_tls_alt)
            echo "--dpi-desync=fake,fakedsplit --dpi-desync-split-pos=1 --dpi-desync-fooling=badseq --dpi-desync-badseq-increment=2 --dpi-desync-repeats=8 --dpi-desync-fake-tls-mod=rnd,dupsid,sni=www.google.com --dpi-desync-fake-http=$bin_dir/tls_clienthello_www_sferum_ru.bin"
            ;;
        general_fake_tls_alt2)
            echo "--dpi-desync=fake,multisplit --dpi-desync-split-seqovl=681 --dpi-desync-split-pos=1 --dpi-desync-fooling=badseq --dpi-desync-badseq-increment=10000000 --dpi-desync-repeats=8 --dpi-desync-split-seqovl-pattern=$bin_dir/tls_clienthello_www_google_com.bin --dpi-desync-fake-tls-mod=rnd,dupsid,sni=www.google.com --dpi-desync-fake-http=$bin_dir/tls_clienthello_www_sferum_ru.bin"
            ;;
        general_fake_tls_alt3)
            echo "--dpi-desync=fake,multisplit --dpi-desync-split-seqovl=681 --dpi-desync-split-pos=1 --dpi-desync-fooling=ts --dpi-desync-repeats=8 --dpi-desync-split-seqovl-pattern=$bin_dir/tls_clienthello_www_google_com.bin --dpi-desync-fake-tls-mod=rnd,dupsid,sni=www.google.com --dpi-desync-fake-http=$bin_dir/tls_clienthello_www_sferum_ru.bin"
            ;;
        general_simple_fake)
            echo "--dpi-desync=fake --dpi-desync-repeats=6 --dpi-desync-fooling=ts --dpi-desync-fake-tls=$bin_dir/tls_clienthello_www_google_com.bin --dpi-desync-fake-http=$bin_dir/tls_clienthello_www_sferum_ru.bin"
            ;;
        general_simple_fake_alt)
            echo "--dpi-desync=fake --dpi-desync-repeats=6 --dpi-desync-fooling=badseq --dpi-desync-badseq-increment=2 --dpi-desync-fake-tls=$bin_dir/stun2.bin --dpi-desync-fake-tls=$bin_dir/tls_clienthello_www_google_com.bin --dpi-desync-fake-http=$bin_dir/tls_clienthello_www_sferum_ru.bin"
            ;;
        general_simple_fake_alt2)
            echo "--dpi-desync=fake --dpi-desync-repeats=6 --dpi-desync-fooling=ts --dpi-desync-fake-tls=$bin_dir/stun2.bin --dpi-desync-fake-tls=$bin_dir/tls_clienthello_www_sferum_ru.bin --dpi-desync-fake-http=$bin_dir/tls_clienthello_www_sferum_ru.bin"
            ;;
        general_exp)
            echo "--dpi-desync=fake,multisplit --dpi-desync-split-seqovl=480 --dpi-desync-split-pos=1 --dpi-desync-fooling=ts --dpi-desync-repeats=4 --dpi-desync-split-seqovl-pattern=$bin_dir/stun2.bin --dpi-desync-fake-tls=$bin_dir/tls_clienthello_www_sferum_ru.bin --dpi-desync-fake-http=$bin_dir/tls_clienthello_www_sferum_ru.bin"
            ;;
        custom)
            echo "$custom"
            ;;
        flowseal_general|*)
            echo "--dpi-desync=multisplit --dpi-desync-split-seqovl=568 --dpi-desync-split-pos=1 --dpi-desync-split-seqovl-pattern=$bin_dir/tls_clienthello_4pda_to.bin"
            ;;
    esac
}

start_service() {
    local enabled=$(uci -q get runet-fix.main.enabled || echo "1")
    [ "$enabled" = "1" ] || {
        echo "[runet-fix] Master switch is disabled in /etc/config/runet-fix"
        stop_service
        return 0
    }

    echo "[runet-fix] Starting all-in-one runet-fix service..."

    # 1. Start Zapret
    local zapret_enabled=$(uci -q get runet-fix.zapret.enabled || echo "1")
    if [ "$zapret_enabled" = "1" ]; then
        local nfq_bin=$(find_nfqws)
        if [ -n "$nfq_bin" ]; then
            local preset=$(uci -q get runet-fix.zapret.preset || echo "flowseal_general")
            local qnum=$(uci -q get runet-fix.zapret.qnum || echo "200")
            local custom_args=$(uci -q get runet-fix.zapret.custom_args || echo "")
            local mode=$(uci -q get runet-fix.zapret.mode || echo "all")
            local discord_fix=$(uci -q get runet-fix.zapret.discord_fix || echo "1")
            local desync_opts=$(get_zapret_args "$preset" "$custom_args")

            local hostlist="/usr/share/runet-fix/lists/zapret-hosts.txt"
            local excludelist="/usr/share/runet-fix/lists/zapret-exclude.txt"
            local bin_dir="/usr/share/runet-fix/bin"

            local args=""
            if [ "$preset" = "custom" ] && echo "$custom_args" | grep -q -- "--qnum"; then
                args="$custom_args"
            else
                # 1. QUIC UDP profile (UDP 443)
                local quic_opts="--filter-udp=443 --dpi-desync=fake --dpi-desync-repeats=11"
                if [ -f "$bin_dir/quic_initial_www_google_com.bin" ]; then
                    quic_opts="$quic_opts --dpi-desync-fake-quic=$bin_dir/quic_initial_www_google_com.bin"
                fi

                # 2. Discord Voice UDP profile (WebRTC & STUN)
                local voice_opts=""
                if [ "$discord_fix" = "1" ]; then
                    voice_opts="--new --filter-udp=19294-19344,50000-50100 --filter-l7=discord,stun --dpi-desync=fake --dpi-desync-repeats=6"
                    if [ -f "$bin_dir/ACTIVE_DISCORD_UDP.bin" ]; then
                        voice_opts="$voice_opts --dpi-desync-fake-discord=$bin_dir/ACTIVE_DISCORD_UDP.bin --dpi-desync-fake-stun=$bin_dir/ACTIVE_DISCORD_UDP.bin"
                    fi
                fi

                # 3. Discord Media TCP profile (ports 2053, 2083, 2087, 2096, 8443)
                local media_opts=""
                if [ "$discord_fix" = "1" ]; then
                    media_opts="--new --filter-tcp=2053,2083,2087,2096,8443 --dpi-desync=fake,multisplit --dpi-desync-split-seqovl=681 --dpi-desync-split-pos=1 --dpi-desync-fooling=ts --dpi-desync-repeats=8"
                    if [ -f "$bin_dir/tls_clienthello_www_google_com.bin" ]; then
                        media_opts="$media_opts --dpi-desync-split-seqovl-pattern=$bin_dir/tls_clienthello_www_google_com.bin --dpi-desync-fake-tls=$bin_dir/tls_clienthello_www_google_com.bin"
                    fi
                fi

                # 4. Online Game UDP Fix (Steam, CS2, Dota 2, GTA Online)
                local game_opts=""
                local game_fix=$(uci -q get runet-fix.zapret.game_fix || echo "0")
                if [ "$game_fix" = "1" ]; then
                    game_opts="--new --filter-udp=27015-27050,7777-7780 --dpi-desync=fake --dpi-desync-repeats=4"
                    if [ -f "$bin_dir/ACTIVE_GAME_UDP.bin" ]; then
                        game_opts="$game_opts --dpi-desync-fake-unknown=$bin_dir/ACTIVE_GAME_UDP.bin"
                    fi
                fi

                # 5. Main Web TCP profile (ports 80, 443)
                local main_tcp="--new --filter-tcp=80,443 $desync_opts"
                if [ "$mode" = "list" ] && [ -s "$hostlist" ]; then
                    main_tcp="$main_tcp --hostlist=$hostlist"
                fi
                if [ -s "$excludelist" ]; then
                    main_tcp="$main_tcp --hostlist-exclude=$excludelist"
                fi

                args="--qnum=$qnum $quic_opts"
                [ -n "$voice_opts" ] && args="$args $voice_opts"
                [ -n "$media_opts" ] && args="$args $media_opts"
                [ -n "$game_opts" ] && args="$args $game_opts"
                args="$args $main_tcp"
            fi

            echo "[runet-fix] Launching $nfq_bin (preset: $preset)..."
            procd_open_instance "zapret"
            procd_set_param command $nfq_bin $args
            procd_set_param respawn 3600 5 0
            procd_set_param stdout 1
            procd_set_param stderr 1
            procd_close_instance
        else
            echo "[runet-fix] Warning: nfqws binary not found in standard paths. Zapret daemon skipped."
        fi
    else
        echo "[runet-fix] Zapret DPI engine is disabled in config."
        killall nfqws nfqws2 >/dev/null 2>&1 || true
    fi

    # 2. Start Telegram Transparent Proxy
    local tg_enabled=$(uci -q get runet-fix.telegram.enabled || echo "1")
    if [ "$tg_enabled" = "1" ]; then
        local tg_port=$(uci -q get runet-fix.telegram.port || echo "1443")
        local tg_engine=$(uci -q get runet-fix.telegram.engine || echo "auto")
        local tg_secret=$(uci -q get runet-fix.telegram.secret || echo "")
        local tg_pool_size=$(uci -q get runet-fix.telegram.pool_size)
        [ -z "$tg_pool_size" ] && tg_pool_size="2"
        local custom_domains=$(uci -q get runet-fix.telegram.custom_domains || echo "")
        local custom_workers=$(uci -q get runet-fix.telegram.custom_workers || echo "")

        # Select Telegram Proxy Engine:
        # 1. Native Rust binary (tg-ws-proxy-rs) - fastest, <2.5MB RAM, no Python dependency
        # 2. Native C binary (tg-transproxy)
        # 3. Python 3 asyncio daemon (fallback)
        local engine_type="python"
        if [ "$tg_engine" = "rust" ] && check_binary "$TG_RUST_BIN"; then
            engine_type="rust"
        elif [ "$tg_engine" = "c_native" ] && check_binary "$TG_C_BIN"; then
            engine_type="c_native"
        elif [ "$tg_engine" = "auto" ]; then
            if check_binary "$TG_RUST_BIN"; then
                engine_type="rust"
            elif check_binary "$TG_C_BIN"; then
                engine_type="c_native"
            else
                engine_type="python"
            fi
        fi

        procd_open_instance "telegram"
        if [ "$engine_type" = "rust" ]; then
            echo "[runet-fix] Launching native Rust Telegram WebSocket proxy on port $tg_port..."
            procd_set_param command "$TG_RUST_BIN" -p "$tg_port" -l "0.0.0.0" --pool-size "$tg_pool_size"
            [ -n "$tg_secret" ] && procd_append_param command -s "$tg_secret"
            [ -n "$custom_domains" ] && procd_append_param command --domains "$custom_domains"
            [ -n "$custom_workers" ] && procd_append_param command --workers "$custom_workers"
        elif [ "$engine_type" = "c_native" ]; then
            echo "[runet-fix] Launching native C Telegram transparent proxy on port $tg_port..."
            procd_set_param command "$TG_C_BIN" -p "$tg_port"
        else
            echo "[runet-fix] Launching Python Telegram WebSocket proxy on port $tg_port..."
            procd_set_param command python3 -u "$TG_PY_SCRIPT" -p "$tg_port" --pool-size "$tg_pool_size"
            [ -n "$tg_secret" ] && procd_append_param command -s "$tg_secret"
            [ -n "$custom_domains" ] && procd_append_param command -d "$custom_domains"
            [ -n "$custom_workers" ] && procd_append_param command -w "$custom_workers"
        fi
        procd_set_param respawn 3600 5 0
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
    else
        echo "[runet-fix] Telegram proxy is disabled in config."
        killall tg-ws-proxy tg-transproxy >/dev/null 2>&1 || true
        pkill -f tg_ws_proxy >/dev/null 2>&1 || true
        pkill -f tg_ws_transparent.py >/dev/null 2>&1 || true
    fi

    # 3. Apply Unified Firewall Rules
    if [ -x "$FIREWALL_SCRIPT" ]; then
        "$FIREWALL_SCRIPT" start
    fi

    # 4. Check DNS Optimization & Adblock (ECH filter & DoH canary)
    local cdir=$(uci -q get dhcp.@dnsmasq[0].confdir)
    if [ "$cdir" != "/tmp/dnsmasq.d" ]; then
        uci set dhcp.@dnsmasq[0].confdir='/tmp/dnsmasq.d'
        uci commit dhcp
        /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
    fi

    # Always ensure ECH Type 65 filtering and DoH canary blocking
    local filter_aaaa=$(uci -q get runet-fix.main.filter_aaaa || echo "0")
    cat << 'EOF' > /tmp/dnsmasq.d/runet-fix-filter.conf
# Strip Type 65 (HTTPS RR) so browsers fallback from ECH/HTTP3 to standard TLS ClientHello
filter-rr=65
# Signal browsers (Firefox, Chrome) to disable DoH and use local DNS
server=/use-application-dns.net/
EOF
    if [ "$filter_aaaa" = "1" ]; then
        echo "filter-aaaa" >> /tmp/dnsmasq.d/runet-fix-filter.conf
    fi

    local adb_enabled=$(uci -q get runet-fix.adblock.enabled || echo "1")
    if [ "$adb_enabled" = "1" ]; then
        if [ ! -f "/tmp/dnsmasq.d/runet-fix-adblock.conf" ]; then
            echo "[runet-fix] Initializing adblock in background..."
            "$ADBLOCK_SCRIPT" >/dev/null 2>&1 &
        else
            [ -f "/tmp/runet-fix-adblock.count" ] || wc -l < /tmp/dnsmasq.d/runet-fix-adblock.conf > /tmp/runet-fix-adblock.count
            /etc/init.d/dnsmasq reload >/dev/null 2>&1 || true
        fi
    else
        echo "[runet-fix] Adblock is disabled in config, removing adblock rules..."
        if [ -f "/tmp/dnsmasq.d/runet-fix-adblock.conf" ]; then
            rm -f /tmp/dnsmasq.d/runet-fix-adblock.conf /tmp/runet-fix-adblock.count
            /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
        else
            /etc/init.d/dnsmasq reload >/dev/null 2>&1 || true
        fi
    fi
}

stop_service() {
    echo "[runet-fix] Stopping runet-fix service..."
    if [ -x "$FIREWALL_SCRIPT" ]; then
        "$FIREWALL_SCRIPT" stop
    fi
    killall -TERM nfqws nfqws2 tg-ws-proxy tg-transproxy >/dev/null 2>&1 || true
    pkill -f tg_ws_proxy >/dev/null 2>&1 || true
    pkill -f tg_ws_transparent.py >/dev/null 2>&1 || true
    local i=0
    while pidof nfqws >/dev/null 2>&1 && [ $i -lt 10 ]; do
        usleep 100000
        i=$((i + 1))
    done
    if pidof nfqws >/dev/null 2>&1; then
        killall -9 nfqws nfqws2 >/dev/null 2>&1 || true
        usleep 100000
    fi
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger "runet-fix"
}

extra_command "update_adblock" "Fetch and generate latest adblock rules"
update_adblock() {
    "$ADBLOCK_SCRIPT"
}

extra_command "status_all" "Display full status of Zapret, Telegram Proxy, and Adblock"
status_all() {
    local ver="1.1.0"
    [ -f /usr/share/runet-fix/version ] && ver=$(cat /usr/share/runet-fix/version | tr -d '\r\n ')
    echo "=== [runet-fix v$ver] All-in-One Status ==="
    local nfq_pid=$(pidof nfqws nfqws2 2>/dev/null)
    if [ -n "$nfq_pid" ]; then
        echo "Zapret (nfqws): RUNNING (PID $nfq_pid)"
    else
        echo "Zapret (nfqws): STOPPED"
    fi

    local tg_pid=$(pidof tg-ws-proxy 2>/dev/null)
    [ -z "$tg_pid" ] && tg_pid=$(pidof tg-transproxy 2>/dev/null)
    [ -z "$tg_pid" ] && tg_pid=$(pgrep -f "tg_ws_proxy" 2>/dev/null)
    [ -z "$tg_pid" ] && tg_pid=$(pgrep -f "tg_ws_transparent.py" 2>/dev/null)
    if [ -n "$tg_pid" ]; then
        echo "Telegram Transparent Proxy: RUNNING (PID $tg_pid)"
    else
        echo "Telegram Transparent Proxy: STOPPED"
    fi

    local adb_rules=$(wc -l < /tmp/dnsmasq.d/runet-fix-adblock.conf 2>/dev/null || echo "0")
    echo "Adblock Rules in dnsmasq: $adb_rules domains blocked"
    echo "======================================"
}
