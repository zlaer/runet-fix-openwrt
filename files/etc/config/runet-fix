config global 'main'
	option enabled '1'
	option log_level 'info'
	option filter_aaaa '0'

config zapret 'zapret'
	option enabled '1'
	option preset 'youtube_4k'
	option mode 'all'
	option discord_fix '1'
	option game_fix '0'
	option qnum '200'
	option custom_args ''
	option exclude_ru '1'
	option autohostlist '1'
	option auto_update_hosts 'weekly'

config telegram 'telegram'
	option enabled '1'
	option mode 'transparent'
	option port '1443'
	# Set to LAN IP (e.g. 192.168.1.1) to bind only to LAN interface
	option listen '0.0.0.0'
	option engine 'auto'
	option pool_size '2'
	# Unique secret generated on first boot if left empty
	option secret ''
	option fake_tls_domain ''
	option custom_domains ''
	option custom_workers ''

config adblock 'adblock'
	option enabled '1'
	option profile 'standard'
	option enable_ru '1'
	option auto_update 'weekly'
