msgstr "Исключать зону РФ (.ru, .рф, .su)"

msgid "Excluded IP Addresses"
msgstr "Исключенные IP-адреса"

msgid "Excluded MAC Addresses"
msgstr "Исключенные MAC-адреса"

msgid "Excludes .ru, .рф, .su domain suffixes across all desync profiles without downloading large lists."
msgstr "Исключение по суффиксу домена .ru, .рф, .su из всех профилей десинхронизации. Полный список доменов не скачивается."

msgid "Exclusion List (Custom Blacklist)"
msgstr "Список исключений (Exclusion List)"

msgid "Fastest preset activated: "
msgstr "Успешно подобран и активирован пресет: "

msgid "Filter IPv6 AAAA Queries (filter-aaaa)"
msgstr "Защита от обхода через IPv6 (filter-aaaa)"

msgid "Filter Profile"
msgstr "Профиль фильтрации"

msgid "Filters out AAAA (IPv6) DNS responses, forcing all LAN devices over IPv4 through Zapret and proxy tunnels without leaks."
msgstr "Блокирует AAAA (IPv6) DNS-ответы, принудительно направляя устройства исключительно по IPv4 через Zapret и прокси без утечек."

msgid "Globally enables or disables all Runet-Fix subsystems."
msgstr "Глобально включает или отключает все подсистемы Runet-Fix."

msgid "How to get a free Cloudflare Worker address (2 minutes):"
msgstr "Как получить бесплатный адрес Cloudflare Worker (2 минуты):"

msgid "INACTIVE"
msgstr "НЕАКТИВЕН"

msgid "IPv4 address (e.g. 192.168.1.150). One per item."
msgstr "IPv4-адрес устройства (например: 192.168.1.150). По одному адресу на строку."

msgid "Instant verification (1–2 sec): YouTube 4K, Discord Gateway, Telegram tunnel, and adblock status."
msgstr "Мгновенная проверка (1–2 сек): доступность YouTube 4K, Discord Gateway, Telegram туннеля и блокировки рекламы."

msgid "Intercept Discord Voice UDP Ports"
msgstr "Перехват голосовых портов Discord UDP"

msgid "Internal Service Port"
msgstr "Порт внутреннего сервиса"

msgid "Kernel queue index used for packet exchange between firewall and nfqws."
msgstr "Номер очереди ядра Linux для обмена пакетами между файрволом и nfqws."

msgid "Latest version installed"
msgstr "Установлена последняя версия"

msgid "Local LAN devices (work VPN laptops, Smart TVs, consoles) whose traffic should bypass Zapret and Telegram proxies entirely."
msgstr "Устройства в домашней сети (рабочие ноутбуки с VPN, Smart TV, приставки), трафик которых должен идти напрямую без десинхронизации Zapret и проксирования Telegram."

msgid "Local router port where transparent traffic is handled (default: 1443)."
msgstr "Локальный порт роутера для прозрачной маршрутизации (по умолчанию 1443)."

msgid "MAC address (e.g. AA:BB:CC:DD:EE:FF). One per item."
msgstr "MAC-адрес устройства (например: AA:BB:CC:DD:EE:FF). По одному на строку."

msgid "MTProxy Secret"
msgstr "Секрет MTProxy"

msgid "Master Switch & System Overview"
msgstr "Главный переключатель и состояние системы"

msgid "Micro (<2 MB RAM - curated RU AdList ~15k domains, for 64MB RAM routers)"
msgstr "Микро (<2 МБ ОЗУ - только RU AdList ~15 тыс. доменов, для роутеров 64 МБ RAM)"

msgid "Netfilter Queue Number (QNUM)"
msgstr "Номер очереди Netfilter (QNUM)"

msgid "No active blocking rules loaded."
msgstr "Правила блокировки не загружены."

msgid "Not checked"
msgstr "Не проверялось"

msgid "Online Games UDP Acceleration (Game UDP Fix)"
msgstr "Ускорение онлайн-игр (Game UDP Fix)"

msgid "Optional: Manual MTProxy Connection"
msgstr "Дополнительно: Ручное подключение MTProxy"

msgid "Overview"
msgstr "Обзор"

msgid "Periodically fetch the latest curated AntiFilter Community blocked domains list."
msgstr "Периодическая загрузка свежего курируемого списка заблокированных доменов AntiFilter Community."

msgid "Queues UDP ports 50000-50100 and 19294-19344 with fake STUN packets to restore Discord voice channels."
msgstr "Направляет UDP-порты 50000-50100 и 19294-19344 с фейковыми STUN-пакетами для восстановления голосовых каналов Discord."

msgid "Quick Actions"
msgstr "Быстрые действия"

msgid "RPC Error: "
msgstr "Ошибка RPC: "

msgid "RU AdList Subscription (Yandex.Direct, VK/Mail.ru trackers, video players)"
msgstr "Подписка RU AdList (Яндекс.Директ, VK/Mail.ru трекеры, кинотеатры)"

msgid "RUNNING"
msgstr "РАБОТАЕТ"

msgid "Real-Time Network Health Probe"
msgstr "Проверка сетевых сервисов в реальном времени"

msgid "Recent System Logs"
msgstr "Системные логи"

msgid "Refresh Logs"
msgstr "Обновить логи"

msgid "Refresh Status"
msgstr "Обновить статус"

msgid "Rerun Test"
msgstr "Повторить тест"

msgid "Response error"
msgstr "Ошибка ответа"

msgid "Restart Services"
msgstr "Перезапустить службы"

msgid "Router firewall intercepts outgoing Telegram DC traffic and tunnels it around ISP throttling."
msgstr "Файрвол роутера автоматически перехватывает соединения к дата-центрам Telegram и туннелирует их в обход ТСПУ."

msgid "Run Zapret Autotune?\n"
"\n"
"Key strategies will be benchmarked against YouTube and Discord (~10-15s). The fastest working preset will be activated automatically."
msgstr "Запустить авто-подбор пресета Zapret?\n"
"\n"
"Будет выполнено тестирование ключевых стратегий против серверов YouTube и Discord (~10-15 сек). Лучший пресет будет автоматически применен."

msgid "Runet Fix"
msgstr "Runet Fix"

msgid "Runet Fix - All-in-One Dashboard"
msgstr "Runet Fix - Панель управления"

msgid "Runet Fix - Diagnostics & System Logs"
msgstr "Runet Fix - Диагностика и логи"

msgid "Runet-Fix Version"
msgstr "Версия Runet-Fix"

msgid "Runet-Fix has been removed. Redirecting..."
msgstr "Runet-Fix успешно удален. Перенаправление..."

msgid "Running Tests..."
msgstr "Тестирование..."

msgid "STOPPED"
msgstr "ОСТАНОВЛЕН"

msgid "Select a desync strategy profile to bypass TSPU/DPI blocking for YouTube 4K, Discord, and other resources."
msgstr "Выберите профиль десинхронизации для обхода ТСПУ/DPI для YouTube 4K, Discord и других ресурсов."

msgid "Select an active device from your network to add to the exclusion list."
msgstr "Выберите активное устройство из сети роутера для добавления в список исключений."

msgid "Select filter intensity. Standard profile includes StevenBlack Unified and Russian filters."
msgstr "Выберите профиль фильтрации. Стандартный включает StevenBlack Unified и русские фильтры."

msgid "Select filtering mode: all traffic, target hostlist only, or target hostlist with auto-detection."
msgstr "Выберите режим фильтрации: весь трафик, по списку или по списку с авто-обнаружением блокировок."

msgid "Service Availability Diagnostics (RuNet Health Probe)"
msgstr "Диагностика доступности сервисов (RuNet Health Probe)"

msgid "Smart Adblock (dnsmasq integration)"
msgstr "Умный Adblock (интеграция с dnsmasq)"

msgid "Standard (StevenBlack + RU AdList ~76k domains)"
msgstr "Стандартный (StevenBlack + RU AdList ~76 тыс. доменов)"

msgid "Subsystem Status"
msgstr "Состояние подсистем"

msgid "Success!"
msgstr "Успешно!"

msgid "Target Hostlist + Auto-Detect (Learns blocked domains automatically)"
msgstr "Список + авто-обнаружение блокировок (Автоматически добавляет недоступные домены)"

msgid "Target Hostlist Only (Conserves router CPU)"
msgstr "Только целевой список доменов (Экономит CPU роутера)"

msgid "Telegram Bypass"
msgstr "Обход блокировок Telegram"

msgid "Telegram Transparent Gateway (Zero Client Configuration)"
msgstr "Прозрачный шлюз Telegram (Без настройки на устройствах)"

msgid "Telegram Transparent Proxy"
msgstr "Telegram Transparent Proxy"

msgid "Telegram WebSocket"
msgstr "Telegram WebSocket"

msgid "Test Services (1 sec)"
msgstr "Проверить сервисы (1 сек)"

msgid "Testing..."
msgstr "Проверка..."

msgid "Traffic Interception Scope"
msgstr "Область перехвата трафика"

msgid "Transparent Gateway Parameters"
msgstr "Параметры прозрачного шлюза"

msgid "Ultra-lightweight DNS-level ad and tracking blocker. Loads high-quality filter lists directly into OpenWrt dnsmasq with zero background memory overhead."
msgstr "Сверхлегкая блокировка рекламы и трекеров на уровне DNS. Загружает качественные фильтры прямо в dnsmasq без расхода оперативной памяти."

msgid "Unavailable"
msgstr "Недоступен"

msgid "Unified high-performance suite for OpenWrt: Zapret DPI bypass, Transparent Telegram WebSocket tunnel, and Smart Adblock."
msgstr "Единый комплекс для OpenWrt: обход блокировок Zapret DPI, прозрачный WebSocket туннель Telegram и умная блокировка рекламы."

msgid "Uninstall Runet-Fix"
msgstr "Удаление Runet-Fix"

msgid "Uninstall cancelled: confirmation mismatch"
msgstr "Удаление отменено: подтверждение не совпадает"

msgid "Uninstalling Runet-Fix from router..."
msgstr "Удаление Runet-Fix с роутера..."

msgid "Update"
msgstr "Обновить"

msgid "Update Adblock Now"
msgstr "Обновить Adblock"

msgid "Update Runet-Fix from GitHub to the latest version?"
msgstr "Выполнить обновление Runet-Fix с GitHub до последней версии?"

msgid "Update Runet-Fix to version v"
msgstr "Выполнить обновление Runet-Fix до версии v"

msgid "Update Zapret Hosts"
msgstr "Обновить список Zapret"

msgid "Update available"
msgstr "Доступно обновление"

msgid "Update error: "
msgstr "Ошибка при обновлении: "

