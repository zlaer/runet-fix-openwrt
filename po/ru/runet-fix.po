msgid "(0 extra daemons, RAM optimized)"
msgstr "(Без фоновых демонов, экономия ОЗУ)"

msgid "(Blocking active)"
msgstr "(Блокировка работает)"

msgid "(Tunnel :1443 active)"
msgstr "(Туннель :1443 активен)"

msgid "(Zero-config for whole LAN)"
msgstr "(Без настройки клиентов, для всей сети)"

msgid "-- Select device from DHCP leases --"
msgstr "-- Выберите устройство из списка DHCP --"

msgid "1. Register at <a href=\"https://dash.cloudflare.com\" target=\"_blank\" style=\"color:#38bdf8;text-decoration:underline;\">dash.cloudflare.com</a> and go to <b>Workers & Pages</b> → <b>Create application</b>.<br>2. Click <b>Create Worker</b> → <b>Deploy</b> → then <b>Edit code</b>.<br>3. Paste the websocket bridge script and click <b>Deploy</b>.<br>4. Copy your assigned <code>*.workers.dev</code> address and paste it into the field above."
msgstr "1. Зарегистрируйтесь на <a href=\"https://dash.cloudflare.com\" target=\"_blank\" style=\"color:#38bdf8;text-decoration:underline;\">dash.cloudflare.com</a> и перейдите в <b>Workers & Pages</b> → <b>Create application</b>.<br>2. Нажмите <b>Create Worker</b> → <b>Deploy</b> → затем <b>Edit code</b>.<br>3. Вставьте скрипт websocket-моста и нажмите <b>Deploy</b>.<br>4. Скопируйте полученный домен (<code>*.workers.dev</code>) и вставьте в поле выше."

msgid "ACTIVE"
msgstr "АКТИВЕН"

msgid "Active DPI Bypass Preset"
msgstr "Профиль стратегии обхода DPI"

msgid "Active Status"
msgstr "Текущий статус"

msgid "Adblock"
msgstr "Блокировка рекламы"

msgid "Adblock Configuration"
msgstr "Настройки Adblock"

msgid "Add Connected Device"
msgstr "Добавить подключенное устройство"

msgid "Add to Exclusions"
msgstr "Добавить в исключения"

msgid "Additional domains or tracking hosts to block. One domain per line."
msgstr "Дополнительные рекламные хосты или трекеры для блокировки. По одному домену на строку."

msgid "Address of your free Cloudflare Worker (e.g. my-tg.username.workers.dev). Router tunnels Telegram traffic for all home devices through this relay, bypassing ISP blocks. Multiple can be comma-separated."
msgstr "Адрес вашего бесплатного воркера (например: my-tg.username.workers.dev). Роутер пропускает через него трафик Telegram всех устройств, полностью обходя блокировку провайдера и ускоряя загрузку фото/видео. Можно указать несколько через запятую."

msgid "Adds specialized filters for blocking Russian ads, trackers, counters, and web players."
msgstr "Добавляет специализированные фильтры блокировки русскоязычной рекламы, счетчиков и онлайн-видеоплееров."

msgid "Aggressive (Standard + Anti-Coinminer protection)"
msgstr "Агрессивный (Стандартный + защита от скрытого майнинга)"

msgid "All Outgoing Traffic (Recommended for full coverage)"
msgstr "Весь исходящий трафик (Рекомендуется для полной работы)"

msgid "All devices on your network (iPhone, Android, Windows, Mac, Smart TV) connect to Telegram automatically.<br>You <b>do not</b> need to configure proxy settings in Telegram apps on any device."
msgstr "Все устройства в вашей сети (iPhone, Android, Windows, Mac, Smart TV) подключаются к Telegram автоматически.<br>Вам <b>не нужно</b> включать прокси в настройках Telegram на телефонах или компьютерах."

msgid "Applies domain-level blocking via dnsmasq address configuration."
msgstr "Блокирует рекламные домены через конфигурацию адресов dnsmasq."

msgid "Auto-Discovered Domains (Auto-Hostlist)"
msgstr "Автоматически обнаруженные домены (Auto-Hostlist)"

msgid "Auto-Update Blocked Hostlist"
msgstr "Авто-обновление списка блокировок"

msgid "Auto-list cleared successfully!"
msgstr "Авто-список успешно очищен!"

msgid "Automatic List Update (Cron)"
msgstr "Автоматическое обновление списков (Cron)"

msgid "Automatically downloads updated filter rules in background."
msgstr "Автоматически загружает свежие правила фильтрации в фоновом режиме."

msgid "Automatically intercepts and tunnels Telegram traffic at the router level. No proxy configuration is required on phones, PCs, or Smart TVs — Telegram works out-of-the-box for all LAN devices."
msgstr "Автоматически перехватывает и туннелирует трафик Telegram на уровне роутера. На смартфонах, компьютерах и Smart TV настраивать прокси НЕ нужно — Telegram работает штатно для всех устройств в домашней сети."

msgid "Autotune error: "
msgstr "Ошибка при авто-подборе: "

msgid "Autotune result: "
msgstr "Результат теста: "

msgid "Available"
msgstr "Доступен"

msgid "Benchmarking desync strategies (Flowseal General, YouTube 4K, ALT, FAKE TLS)... Please wait."
msgstr "Идет тестирование стратегий десинхронизации (Flowseal General, YouTube 4K, ALT, FAKE TLS)... Пожалуйста, подождите."

msgid "Blacklist (Always Block)"
msgstr "Черный список (Всегда блокировать)"

msgid "Blocked"
msgstr "Заблокирован"

msgid "Check connectivity status to YouTube, Discord, and Telegram WebSocket relays, and view live system logs."
msgstr "Проверка доступности YouTube, Discord и WebSocket-реле Telegram, а также просмотр системных логов."

msgid "Check for Updates"
msgstr "Проверить обновления"

msgid "Checking GitHub..."
msgstr "Сверка с GitHub..."

msgid "Clear Auto-List"
msgstr "Очистить авто-список"

msgid "Cloudflare Worker (Relay Address)"
msgstr "Cloudflare Worker (Адрес реле)"

msgid "Cloudflare Worker Setup (Advanced)"
msgstr "Настройка Cloudflare Worker (дополнительно)"

msgid "Completely Uninstall Runet-Fix"
msgstr "Полностью удалить Runet-Fix"

msgid "Completely remove the Runet-Fix suite, stop all daemons, delete nftables firewall rules, clean cron schedule and LuCI web views."
msgstr "Полное и чистое удаление пакета Runet-Fix, остановка служб, сброс правил файрвола nftables, очистка cron и интерфейса LuCI."

msgid "Configures nfqws packet desynchronization for unthrottling YouTube 4K, Discord voice & media, and ISP-blocked sites."
msgstr "Настройка десинхронизации пакетов nfqws для ускорения YouTube 4K, Discord и заблокированных сайтов."

msgid "Connect in Telegram"
msgstr "Подключить в Telegram"

msgid "Connected"
msgstr "Подключен"

msgid "Connectivity Test"
msgstr "Тест сетевой доступности"

msgid "Copy"
msgstr "Копировать"

msgid "Custom Arguments (Enter below)"
msgstr "Пользовательские аргументы (введите ниже)"

msgid "Custom Cloudflare Relay Domains (CfProxy)"
msgstr "Дополнительные домены Cloudflare (CfProxy)"

msgid "Custom Whitelist & Blacklist"
msgstr "Белый и черный списки пользователя"

msgid "Custom domains pointed to Cloudflare (kws1..kws5). Leave empty if using Worker."
msgstr "Пользовательские домены, направленные на Cloudflare (kws1..kws5). Оставьте пустым, если указан Worker."

msgid "Custom nfqws Arguments"
msgstr "Пользовательские аргументы nfqws"

msgid "Custom user exclusion list of domains that should NOT be desynchronized. All subdomains are automatically excluded. One domain per line."
msgstr "Пользовательский список доменов (черный список), которые НЕ должны подвергаться десинхронизации пакетов. Все поддомены исключаются автоматически. По одному домену на строку."

msgid "DNS & Adblock"
msgstr "DNS и Adblock"

msgid "DNS Error"
msgstr "Ошибка DNS"

msgid "DNS OK"
msgstr "DNS OK"

msgid "Daily"
msgstr "Ежедневно"

msgid "Daily (Every night at 04:00)"
msgstr "Ежедневно (Каждую ночь в 04:00)"

msgid "Desynchronizes UDP ports 27015-27050 and 7777-7780 (Steam, CS2, Dota 2, GTA Online) with game binary patterns to eliminate TSPU packet drops."
msgstr "Направляет сетевые UDP-порты 27015-27050 и 7777-7780 (Steam, CS2, Dota 2, GTA Online) через Netfilter с игровыми бинарными паттернами для предотвращения потерь пакетов."

msgid "Device Bypass (LAN Exclusion)"
msgstr "Исключение устройств локальной сети (Device Bypass)"

msgid "Device added to exclusions: "
msgstr "Устройство добавлено в исключения: "

msgid "Diagnostics & Logs"
msgstr "Диагностика и логи"

msgid "Directs selected outgoing TCP/UDP traffic to Netfilter queue for desynchronization."
msgstr "Направляет исходящий трафик в очередь Netfilter для десинхронизации пакетов."

msgid "Disabled"
msgstr "Отключено"

msgid "Disabled (Manual update only)"
msgstr "Отключено (Только ручное обновление)"

msgid "Discord Gateway"
msgstr "Discord Gateway"

msgid "Domains that are desynchronized in \"Target Hostlist Only\" and \"Target Hostlist + Auto-Detect\" modes. One domain per line."
msgstr "Домены, которые обрабатываются через Zapret в режимах «Только список» и «Список + авто-обнаружение». По одному домену на строку."

msgid "Domains that were dynamically identified by nfqws as blocked and added to DPI bypass (persists across reboots)."
msgstr "Домены, которые были автоматически определены nfqws как заблокированные и добавлены в обход DPI (сохраняются между перезагрузками)."

msgid "Domains to exclude from adblocking. One domain per line."
msgstr "Домены, которые нельзя блокировать. По одному домену на строку."

msgid "Download latest blocked domains and merge with your custom hostlist."
msgstr "Загрузить свежие заблокированные домены и объединить с вашим локальным списком."

msgid "Downloading latest release from GitHub, updating files and restarting services..."
msgstr "Загрузка свежего релиза с GitHub, обновление бинарных файлов, скриптов и перезапуск сервисов..."

msgid "Enable Adblock"
msgstr "Включить блокировку рекламы"

msgid "Enable All Services"
msgstr "Включить все службы"

msgid "Enable Telegram Transparent Gateway"
msgstr "Включить прозрачный шлюз Telegram"

msgid "Enable Zapret DPI Engine"
msgstr "Включить движок Zapret DPI"

msgid "Error Running Test"
msgstr "Ошибка выполнения теста"

